{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Parallax dataset manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "source",
    "version",
    "license",
    "access_date",
    "shards",
    "supports_novel_conditions",
    "supports_intervention"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string"},
    "source": {"type": "string"},
    "version": {"type": "string"},
    "license": {"type": "string"},
    "access_date": {"type": "string", "format": "date"},
    "shards": {"type": "array"},
    "supports_novel_conditions": {"type": "boolean"},
    "supports_intervention": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
